# Copy this file to .env and fill in values
#   cp .env.example .env
#
# Required
SEARXNG_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Optional — defaults shown
PORT=5000
MCP_SSE_PORT=8765
MCPO_PORT=8000
# Bind to 127.0.0.1 to restrict MCP to local access; default 0.0.0.0
MCP_HOST=0.0.0.0
SEARXNG_HOST_PORT=8888

# Host user UID/GID — passed at build time so container writes files owned by
# the host user, not root.  Match your local user (id -u / id -g).
HOST_UID=1000
HOST_GID=1000

# LLM backend for Commander Eval (optional — openai, anthropic, or leave unset)
LLM_BACKEND=openai
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
