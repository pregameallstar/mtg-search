# Copy this file to .env and fill in values
#   cp .env.example .env
#
# Required
SEARXNG_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Optional — defaults shown
PORT=5000
MCP_SSE_PORT=8765
MCPO_PORT=8000
# Host-side bind address for the published ports. Loopback is the safe default;
# set BIND_ADDR=0.0.0.0 only when you deliberately want LAN access.
BIND_ADDR=127.0.0.1
# Inside the container the Flask/MCP services bind all interfaces so Docker's
# port mapping works. Do not change these unless you run outside Docker.
FLASK_HOST=0.0.0.0
MCP_HOST=0.0.0.0
# Optional comma-separated browser origins allowed to call MCP. Defaults to
# loopback origins (localhost/127.0.0.1) to prevent arbitrary websites from
# reading deck data; set this for a remote OpenWebUI instance.
# MCP_CORS_ORIGINS=http://192.168.1.20:3000
# Reject request bodies larger than this (bytes). MTGJSON uploads are large.
MAX_UPLOAD_BYTES=2147483648
SEARXNG_HOST_PORT=8888

# Host user UID/GID — passed at build time so container writes files owned by
# the host user, not root.  Match your local user (id -u / id -g).
HOST_UID=1000
HOST_GID=1000

# LLM backend for Commander Eval and Deck Doctor (optional — openai, anthropic,
# or leave unset)
LLM_BACKEND=openai
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# Bound a single LLM request so a hung endpoint cannot leave a review spinning.
LLM_TIMEOUT_SECONDS=120
