# Copy this file to .env and fill in values
#   cp .env.example .env
#
# Required
SEARXNG_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Optional — defaults shown
PORT=5000
MCP_SSE_PORT=8765
MCPO_PORT=8000
SEARXNG_HOST_PORT=8888

# LLM backend for Commander Eval (optional — openai, anthropic, or leave unset)
LLM_BACKEND=openai
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
